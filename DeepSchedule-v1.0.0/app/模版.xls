ng"></Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell></Row><Row ss:Height="26"><Cell ss:StyleID="time"><Data ss:Type="String">第十四节课</Data></Cell><Cell ss:StyleID="time"><Data ss:Type="String">19:55-20:40</Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String"></Data></Cell></Row></Table></Worksheet><Worksheet ss:Name="填写说明"><Table><Column ss:Width="110"/><Column ss:Width="520"/><Row><Cell ss:StyleID="time"><Data ss:Type="String">怎么填</Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String">一格 = 一节课；单元格里写三行：课名 / 教室 / 教师（Alt+Enter 换行）。</Data></Cell></Row><Row><Cell ss:StyleID="time"><Data ss:Type="String">周次</Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String">每个 sheet 名就是周次，写「第3周」或「3」都认。</Data></Cell></Row><Row><Cell ss:StyleID="time"><Data ss:Type="String">节次</Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String">从第二行起依次第一节到第十四节，别插空行。</Data></Cell></Row><Row><Cell ss:StyleID="time"><Data ss:Type="String">时间</Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String">第二列是作息时间，学校不同就整列改。</Data></Cell></Row><Row><Cell ss:StyleID="time"><Data ss:Type="String">导入</Data></Cell><Cell ss:StyleID="day"><Data ss:Type="String">桌宠右键 → 导入课表… → 选文件 → 告诉它今天是第几周。</Data></Cell></Row></Table></Worksheet></Workbook>